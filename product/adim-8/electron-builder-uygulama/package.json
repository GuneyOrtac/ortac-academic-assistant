{
  "name": "akademik-asistan",
  "version": "0.0.3",
  "description": "ORTAC Geo|Science - Akademik Asistan",
  "main": "build/main.js",
  "scripts": {
    "package": "electron-builder"
  },
  "keywords": [
    "academic",
    "research",
    "ai",
    "assistant"
  ],
  "author": "Dr. Guney ORTAC",
  "license": "EĞİTİM VE ARAŞTIRMA KULLANIMI İÇİN BEDAVA",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {},
  "productName": "Akademik Asistan",
  "build": {
    "appId": "com.ortacgeoscience.akademikasistan",
    "directories": {
      "output": "../releases"
    },
    "files": [
      "dist/**/*",
      "build/**/*.js",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend"
      }
    ],
    "extraMetadata": {
      "main": "build/main.js",
      "copyright": "2026 Dr. Güney ORTAÇ - Tüm Hakları Saklıdır."
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ORTAC Akademik Asistan",
      "runAfterFinish": true,
      "artifactName": "ORTAC.Akademik.Asistan.Setup.0.0.3.exe"
    }
  }
}