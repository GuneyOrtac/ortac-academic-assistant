{
  "name": "ortac-akademik-asistan-kurulum",
  "version": "0.0.3",
  "description": "ORTAC Geo|Science - Akademik Asistan Kurulum Sihirbazı",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "package": "electron-builder"
  },
  "author": "Dr. Guney ORTAC",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.ortacgeoscience.installer",
    "productName": "ORTAC Akademik Asistan Kurulumu",
    "directories": {
      "output": "../final-release"
    },
    "files": [
      "dist/**/*",
      "src/**/*.js",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "payload",
        "to": "payload"
      },
      {
        "from": "assets/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "ORTAC.Akademik.Asistan.Setup.0.0.3.exe"
    }
  }
}
